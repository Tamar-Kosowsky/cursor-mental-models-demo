ener('click', (e) => {\n        if (e.target === modalOverlay) {\n            closeModal();\n        }\n    });\n    \n    // Escape key handler\n    document.addEventListener('keydown', (e) => {\n        if (e.key === 'Escape' && currentModalId !== null) {\n            closeModal();\n        }\n    });\n    \n    // Load data\n    loadData();\n}\n\n// Start the app when DOM is ready\nif (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n} else {\n    init();\n}\n","new_string":"// State Management\nlet mentalModels = [];\nlet filteredModels = [];\nlet currentModalId = null;\n\n// DOM Elements\nconst cardsContainer = document.getElementById('cards-container');\nconst searchInput = document.getElementById('search-input');\nconst modalOverlay = document.getElementById('modal-overlay');\nconst modalBody = document.getElementById('modal-body');\nconst modalClose = document.getElementById('modal-close');\nconst noResults = document.getElementById('no-results');\n\n// Load data from JSON file\nasync function loadData() {\n    try {\n        const response = await fetch('data/mental-models.json');\n        if (!response.ok) {\n            throw new Error('Failed to load mental models data');\n        }\n        const data = await response.json();\n        mentalModels = data.mentalModels || [];\n        filteredModels = [...mentalModels];\n        renderCards();\n    } catch (error) {\n        console.error('Error loading data:', error);\n        cardsContainer.innerHTML = '<p style=\"text-align: center; color: #666;\">Error loading mental models. Please refresh the page.</p>';\n    }\n}\n\n// Render cards in the grid\nfunction renderCards() {\n    cardsContainer.innerHTML = '';\n    \n    if (filteredModels.length === 0) {\n        noResults.style.display = 'block';\n        return;\n    }\n    \n    noResults.style.display = 'none';\n    \n    filteredModels.forEach(model => {\n        const card = createCardElement(model);\n        cardsContainer.appendChild(card);\n    });\n}\n\n// Create a card DOM element\nfunction createCardElement(model) {\n    const card = document.createElement('div');\n    card.className = 'card';\n    card.setAttribute('data-id', model.id);\n    \n    const title = document.createElement('h2');\n    title.className = 'card-title';\n    title.textContent = model.title;\n    \n    const description = document.createElement('p');\n    description.className = 'card-description';\n    description.textContent = model.shortDescription;\n    \n    const tagsContainer = document.createElement('div');\n    tagsContainer.className = 'card-tags';\n    \n    if (model.relatedFeatures && model.relatedFeatures.length > 0) {\n        model.relatedFeatures.forEach(feature => {\n            const tag = document.createElement('span');\n            tag.className = 'tag';\n            tag.textContent = feature;\n            tagsContainer.appendChild(tag);\n        });\n    }\n    \n    card.appendChild(title);\n    card.appendChild(description);\n    card.appendChild(tagsContainer);\n    \n    // Add click handler\n    card.addEventListener('click', () => {\n        openModal(model.id);\n    });\n    \n    return card;\n}\n\n// Filter cards based on search term\nfunction filterCards(searchTerm) {\n    // #region agent log\n    fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:87',message:'filterCards called',data:{searchTerm:searchTerm},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'D'})}).catch(()=>{});\n    // #endregion\n    \n    const term = searchTerm.trim();\n    \n    // #region agent log\n    fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:90',message:'term after trim',data:{term:term,originalLength:searchTerm.length,trimmedLength:term.length},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'})}).catch(()=>{});\n    // #endregion\n    \n    if (term === '') {\n        filteredModels = [...mentalModels];\n    } else {\n        // Convert search term to lowercase for case-insensitive matching\n        const termLower = term.toLowerCase();\n        \n        filteredModels = mentalModels.filter(model => {\n            // #region agent log\n            fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:95',message:'comparing model',data:{modelTitle:model.title,searchTerm:term,titleLower:model.title.toLowerCase(),termLower:termLower},timestamp:Date.now(),sessionId:'debug-session',runId:'post-fix',hypothesisId:'A'})}).catch(()=>{});\n            // #endregion\n            \n            // Case-insensitive comparison: convert both sides to lowercase\n            const titleMatch = model.title.toLowerCase().includes(termLower);\n            \n            // #region agent log\n            fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:98',message:'titleMatch result',data:{titleMatch:titleMatch,modelTitle:model.title,term:term,termLower:termLower},timestamp:Date.now(),sessionId:'debug-session',runId:'post-fix',hypothesisId:'A'})}).catch(()=>{});\n            // #endregion\n            \n            // Case-insensitive comparison: convert both sides to lowercase\n            const descMatch = model.shortDescription.toLowerCase().includes(termLower);\n            \n            // #region agent log\n            fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:101',message:'descMatch result',data:{descMatch:descMatch,description:model.shortDescription,term:term,termLower:termLower},timestamp:Date.now(),sessionId:'debug-session',runId:'post-fix',hypothesisId:'B'})}).catch(()=>{});\n            // #endregion\n            \n            // Case-insensitive comparison: convert both sides to lowercase\n            const featuresMatch = model.relatedFeatures.some(feature => \n                feature.toLowerCase().includes(termLower)\n            );\n            \n            // #region agent log\n            fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:106',message:'featuresMatch result',data:{featuresMatch:featuresMatch,features:model.relatedFeatures,term:term,termLower:termLower},timestamp:Date.now(),sessionId:'debug-session',runId:'post-fix',hypothesisId:'C'})}).catch(()=>{});\n            // #endregion\n            \n            const finalMatch = titleMatch || descMatch || featuresMatch;\n            \n            // #region agent log\n            fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:110',message:'final match result',data:{finalMatch:finalMatch,titleMatch:titleMatch,descMatch:descMatch,featuresMatch:featuresMatch,modelTitle:model.title},timestamp:Date.now(),sessionId:'debug-session',runId:'post-fix',hypothesisId:'A,B,C'})}).catch(()=>{});\n            // #endregion\n            \n            return finalMatch;\n        });\n    }\n    \n    // #region agent log\n    fetch('http://127.0.0.1:7243/ingest/588518f7-72d2-405a-b649-9e6746d40f93',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'app.js:115',message:'filterCards complete',data:{filteredCount:filteredModels.length,totalCount:mentalModels.length,searchTerm:term},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A,B,C'})}).catch(()=>{});\n    // #endregion\n    \n    renderCards();\n}\n\n// Open modal with model details\nfunction openModal(modelId) {\n    const model = mentalModels.find(m => m.id === modelId);\n    if (!model) {\n        return;\n    }\n    \n    currentModalId = modelId;\n    \n    // Build modal content\n    let html = `\n        <h2 class=\"modal-title\">${escapeHtml(model.title)}</h2>\n    `;\n    \n    // Detailed explanation\n    if (model.detailedExplanation && model.detailedExplanation.length > 0) {\n        html += `\n            <div class=\"modal-section\">\n                <h3 class=\"modal-section-title\">Detailed Explanation</h3>\n                <ul class=\"modal-explanation\">\n        `;\n        model.detailedExplanation.forEach(point => {\n            html += `<li>${escapeHtml(point)}</li>`;\n        });\n        html += `\n                </ul>\n            </div>\n        `;\n    }\n    \n    // Related features\n    if (model.relatedFeatures && model.relatedFeatures.length > 0) {\n        html += `\n            <div class=\"modal-section\">\n                <h3 class=\"modal-section-title\">Related Features</h3>\n                <div class=\"modal-features\">\n        `;\n        model.relatedFeatures.forEach(feature => {\n            html += `<span class=\"tag\">${escapeHtml(feature)}</span>`;\n        });\n        html += `\n                </div>\n            </div>\n        `;\n    }\n    \n    // Documentation links\n    if (model.docs && model.docs.length > 0) {\n        html += `\n            <div class=\"modal-section\">\n                <h3 class=\"modal-section-title\">Documentation</h3>\n                <ul class=\"modal-docs\">\n        `;\n        model.docs.forEach(doc => {\n            html += `<li><a href=\"${escapeHtml(doc.url)}\" target=\"_blank\" rel=\"noopener noreferrer\">${escapeHtml(doc.label)}</a></li>`;\n        });\n        html += `\n                </ul>\n            </div>\n        `;\n    }\n    \n    modalBody.innerHTML = html;\n    modalOverlay.style.display = 'flex';\n    document.body.style.overflow = 'hidden';\n}\n\n// Close modal\nfunction closeModal() {\n    modalOverlay.style.display = 'none';\n    currentModalId = null;\n    document.body.style.overflow = '';\n}\n\n// Escape HTML to prevent XSS\nfunction escapeHtml(text) {\n    const div = document.createElement('div');\n    div.textContent = text;\n    return div.innerHTML;\n}\n\n// Initialize the application\nfunction init() {\n    // Search input event listener\n    searchInput.addEventListener('input', (e) => {\n        filterCards(e.target.value);\n    });\n    \n    // Modal close handlers\n    modalClose.addEventListener('click', closeModal);\n    \n    modalOverlay.addEventListener('click', (e) => {\n        if (e.target === modalOverlay) {\n            closeModal();\n        }\n    });\n    \n    // Escape key handler\n    document.addEventListener('keydown', (e) => {\n        if (e.key === 'Escape' && currentModalId !== null) {\n            closeModal();\n        }\n    });\n    \n    // Load data\n    loadData();\n}\n\n// Start the app when DOM is ready\nif (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n} else {\n    init();\n}\n"}],"hook_event_name":"afterFileEdit","cursor_version":"2.3.15","workspace_roots":["/Users/tamar/cursor-mental-models-demo"],"user_email":"t0548453823@gmail.com"}
