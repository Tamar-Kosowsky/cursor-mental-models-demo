[2026-01-05 21:45:18] {"conversation_id":"24c79d65-b178-4990-84f4-3af8de47fb43","generation_id":"d8f5a732-352b-4499-a7c4-55dc994f566e","model":"composer-1","file_path":"/Users/tamar/.cursor/worktrees/cursor-mental-models-demo/tlv/e2e.test.js","edits":[{"old_string":"","new_string":"/**\n * End-to-end tests for Cursor Mental Models Demo Site\n * \n * To run these tests:\n * 1. Install Playwright: npm install -D @playwright/test\n * 2. Install browsers: npx playwright install\n * 3. Start a local server: npx serve . (or python -m http.server 8000)\n * 4. Run tests: npx playwright test\n */\n\nconst { test, expect } = require('@playwright/test');\n\n// Base URL - adjust if your server runs on a different port\nconst BASE_URL = process.env.BASE_URL || 'http://localhost:8000';\n\ntest.describe('Cursor Mental Models Demo Site', () => {\n  test.beforeEach(async ({ page }) => {\n    await page.goto(BASE_URL);\n    // Wait for data to load\n    await page.waitForSelector('.card', { timeout: 5000 });\n  });\n\n  test('should load the page and display header', async ({ page }) => {\n    const header = page.locator('header h1');\n    await expect(header).toBeVisible();\n    await expect(header).toHaveText('Cursor Mental Models');\n    \n    const subtitle = page.locator('.subtitle');\n    await expect(subtitle).toBeVisible();\n    await expect(subtitle).toHaveText('AI Terms Dictionary');\n  });\n\n  test('should display mental model cards', async ({ page }) => {\n    const cards = page.locator('.card');\n    const count = await cards.count();\n    \n    // Should have at least some cards loaded\n    expect(count).toBeGreaterThan(0);\n    \n    // Check that cards have expected structure\n    const firstCard = cards.first();\n    await expect(firstCard.locator('.card-title')).toBeVisible();\n    await expect(firstCard.locator('.card-description')).toBeVisible();\n  });\n\n  test('should display search input', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    await expect(searchInput).toBeVisible();\n    await expect(searchInput).toHaveAttribute('placeholder', 'Search mental models...');\n  });\n\n  test('should filter cards when searching by title', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    const cards = page.locator('.card');\n    \n    // Get initial card count\n    const initialCount = await cards.count();\n    expect(initialCount).toBeGreaterThan(0);\n    \n    // Search for \"Planner\"\n    await searchInput.fill('Planner');\n    await page.waitForTimeout(300); // Wait for debounce/filter\n    \n    // Should show filtered results\n    const filteredCards = page.locator('.card');\n    const filteredCount = await filteredCards.count();\n    expect(filteredCount).toBeGreaterThan(0);\n    expect(filteredCount).toBeLessThanOrEqual(initialCount);\n    \n    // Check that visible cards contain \"Planner\" in title\n    const visibleTitles = await filteredCards.locator('.card-title').allTextContents();\n    visibleTitles.forEach(title => {\n      expect(title.toLowerCase()).toContain('planner');\n    });\n  });\n\n  test('should filter cards when searching by description', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    \n    // Search for a term that appears in descriptions\n    await searchInput.fill('collaborates');\n    await page.waitForTimeout(300);\n    \n    const cards = page.locator('.card');\n    const count = await cards.count();\n    \n    // Should show at least one result\n    expect(count).toBeGreaterThan(0);\n    \n    // Verify the card contains the search term\n    const firstCard = cards.first();\n    const description = await firstCard.locator('.card-description').textContent();\n    expect(description.toLowerCase()).toContain('collaborates');\n  });\n\n  test('should show \"no results\" message when search has no matches', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    const noResults = page.locator('#no-results');\n    \n    // Search for something that doesn't exist\n    await searchInput.fill('xyz123nonexistent');\n    await page.waitForTimeout(300);\n    \n    // Should show no results message\n    await expect(noResults).toBeVisible();\n    await expect(noResults).toContainText('No mental models found');\n    \n    // Should hide cards\n    const cards = page.locator('.card');\n    const count = await cards.count();\n    expect(count).toBe(0);\n  });\n\n  test('should clear search and show all cards again', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    const cards = page.locator('.card');\n    \n    // Get initial count\n    const initialCount = await cards.count();\n    \n    // Search for something\n    await searchInput.fill('Planner');\n    await page.waitForTimeout(300);\n    \n    // Clear search\n    await searchInput.clear();\n    await page.waitForTimeout(300);\n    \n    // Should show all cards again\n    const finalCount = await cards.count();\n    expect(finalCount).toBe(initialCount);\n    \n    // No results message should be hidden\n    const noResults = page.locator('#no-results');\n    await expect(noResults).not.toBeVisible();\n  });\n\n  test('should open modal when clicking a card', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    const modalBody = page.locator('#modal-body');\n    \n    // Modal should be hidden initially\n    await expect(modalOverlay).not.toBeVisible();\n    \n    // Click first card\n    await cards.first().click();\n    \n    // Modal should be visible\n    await expect(modalOverlay).toBeVisible();\n    \n    // Modal should have content\n    await expect(modalBody).toBeVisible();\n    \n    // Should have a title\n    const modalTitle = modalBody.locator('.modal-title');\n    await expect(modalTitle).toBeVisible();\n  });\n\n  test('should display correct content in modal', async ({ page }) => {\n    const cards = page.locator('.card');\n    \n    // Get title from first card\n    const cardTitle = await cards.first().locator('.card-title').textContent();\n    \n    // Click card to open modal\n    await cards.first().click();\n    \n    // Check modal title matches card title\n    const modalTitle = page.locator('.modal-title');\n    await expect(modalTitle).toHaveText(cardTitle);\n    \n    // Check for detailed explanation section\n    const explanationSection = page.locator('.modal-section').filter({ hasText: 'Detailed Explanation' });\n    await expect(explanationSection).toBeVisible();\n    \n    // Check for related features section\n    const featuresSection = page.locator('.modal-section').filter({ hasText: 'Related Features' });\n    await expect(featuresSection).toBeVisible();\n    \n    // Check for documentation section\n    const docsSection = page.locator('.modal-section').filter({ hasText: 'Documentation' });\n    await expect(docsSection).toBeVisible();\n  });\n\n  test('should close modal when clicking close button', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    const closeButton = page.locator('#modal-close');\n    \n    // Open modal\n    await cards.first().click();\n    await expect(modalOverlay).toBeVisible();\n    \n    // Click close button\n    await closeButton.click();\n    \n    // Modal should be hidden\n    await expect(modalOverlay).not.toBeVisible();\n  });\n\n  test('should close modal when pressing ESC key', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    \n    // Open modal\n    await cards.first().click();\n    await expect(modalOverlay).toBeVisible();\n    \n    // Press ESC key\n    await page.keyboard.press('Escape');\n    \n    // Modal should be hidden\n    await expect(modalOverlay).not.toBeVisible();\n  });\n\n  test('should close modal when clicking outside modal content', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    const modalContent = page.locator('.modal-content');\n    \n    // Open modal\n    await cards.first().click();\n    await expect(modalOverlay).toBeVisible();\n    \n    // Click on overlay (outside modal content)\n    // Get bounding box of overlay and click near the edge\n    const overlayBox = await modalOverlay.boundingBox();\n    if (overlayBox) {\n      await page.mouse.click(overlayBox.x + 10, overlayBox.y + 10);\n    }\n    \n    // Modal should be hidden\n    await expect(modalOverlay).not.toBeVisible();\n  });\n\n  test('should not close modal when clicking inside modal content', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    const modalContent = page.locator('.modal-content');\n    \n    // Open modal\n    await cards.first().click();\n    await expect(modalOverlay).toBeVisible();\n    \n    // Click inside modal content\n    await modalContent.click();\n    \n    // Modal should still be visible\n    await expect(modalOverlay).toBeVisible();\n  });\n\n  test('should handle multiple modal opens and closes', async ({ page }) => {\n    const cards = page.locator('.card');\n    const modalOverlay = page.locator('#modal-overlay');\n    \n    // Open first card\n    await cards.first().click();\n    await expect(modalOverlay).toBeVisible();\n    \n    // Close modal\n    await page.keyboard.press('Escape');\n    await expect(modalOverlay).not.toBeVisible();\n    \n    // Open second card\n    const cardCount = await cards.count();\n    if (cardCount > 1) {\n      await cards.nth(1).click();\n      await expect(modalOverlay).toBeVisible();\n      \n      // Verify different content\n      const modalTitle = page.locator('.modal-title');\n      const title1 = await cards.first().locator('.card-title').textContent();\n      const title2 = await cards.nth(1).locator('.card-title').textContent();\n      const modalTitleText = await modalTitle.textContent();\n      \n      expect(modalTitleText).toBe(title2);\n      expect(modalTitleText).not.toBe(title1);\n    }\n  });\n\n  test('should display feature tags on cards', async ({ page }) => {\n    const cards = page.locator('.card');\n    const firstCard = cards.first();\n    \n    // Check for tags container\n    const tagsContainer = firstCard.locator('.card-tags');\n    await expect(tagsContainer).toBeVisible();\n    \n    // Check for tags\n    const tags = firstCard.locator('.tag');\n    const tagCount = await tags.count();\n    expect(tagCount).toBeGreaterThan(0);\n  });\n\n  test('should have accessible modal close button', async ({ page }) => {\n    const cards = page.locator('.card');\n    const closeButton = page.locator('#modal-close');\n    \n    // Open modal\n    await cards.first().click();\n    \n    // Check aria-label on close button\n    await expect(closeButton).toHaveAttribute('aria-label', 'Close modal');\n  });\n\n  test('should handle search with special characters', async ({ page }) => {\n    const searchInput = page.locator('#search-input');\n    \n    // Try searching with special characters\n    await searchInput.fill('@#$%');\n    await page.waitForTimeout(300);\n    \n    // Should handle gracefully (either show no results or handle safely)\n    const noResults = page.locator('#no-results');\n    const cards = page.locator('.card');\n    \n    // Either no results or cards are shown (both are valid)\n    const cardCount = await cards.count();\n    const noResultsVisible = await noResults.isVisible();\n    \n    expect(cardCount === 0 || !noResultsVisible || (cardCount > 0 && !noResultsVisible)).toBeTruthy();\n  });\n});\n"}],"hook_event_name":"afterFileEdit","cursor_version":"2.3.15","workspace_roots":["/Users/tamar/cursor-mental-models-demo"],"user_email":"t0548453823@gmail.com"}
